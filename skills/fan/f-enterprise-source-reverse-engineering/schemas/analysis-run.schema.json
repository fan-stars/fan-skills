{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "analysis_run_id", "project", "requested_module", "started_at", "finished_at",
    "source_root", "workspace", "stages", "files_scanned", "files_read",
    "files_reused_without_content_read", "files_written", "stale_evidence",
    "unresolved_questions", "final_status"
  ],
  "properties": {
    "analysis_run_id": {"type": "string", "pattern": "^(A|B|COMPARE|JAVA)-[a-z0-9-]+-[0-9]{8}-[0-9]{3}$"},
    "project": {"enum": ["A", "B", "COMPARE", "JAVA"]},
    "requested_module": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "source_root": {"type": "string", "minLength": 1},
    "workspace": {"type": "string", "minLength": 1},
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "command", "exit_code", "duration_ms", "stdout", "stderr"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "command": {"type": "array", "minItems": 2, "items": {"type": "string"}},
          "exit_code": {"type": "integer"},
          "duration_ms": {"type": "integer", "minimum": 0},
          "stdout": {"type": "string"},
          "stderr": {"type": "string"}
        }
      }
    },
    "files_scanned": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "files_read": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "files_reused_without_content_read": {"type": "array", "items": {"type": "string"}},
    "files_written": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "stale_evidence": {"type": "array"},
    "unresolved_questions": {"type": "array"},
    "final_status": {"enum": ["COMPLETED", "PARTIAL", "REVIEW_REQUIRED", "BLOCKED", "FAILED"]}
  }
}
