{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "project", "repository_root", "source_index_version", "file_count",
    "changed_or_deleted", "unchanged_reused", "content_read_files",
    "reused_without_content_read", "deleted_files", "verify_all",
    "source_index_sha256", "snapshot_id", "updated_at"
  ],
  "properties": {
    "project": {"enum": ["A", "B"]},
    "repository_root": {"type": "string", "minLength": 1},
    "source_index_version": {"type": "integer", "minimum": 1},
    "file_count": {"type": "integer", "minimum": 0},
    "changed_or_deleted": {"type": "integer", "minimum": 0},
    "unchanged_reused": {"type": "integer", "minimum": 0},
    "content_read_files": {"type": "array", "items": {"type": "string"}},
    "reused_without_content_read": {"type": "array", "items": {"type": "string"}},
    "deleted_files": {"type": "array", "items": {"type": "string"}},
    "verify_all": {"type": "boolean"},
    "source_index_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "snapshot_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
