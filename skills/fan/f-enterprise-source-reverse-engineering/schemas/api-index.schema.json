{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "coverage": {
      "type": "object",
      "required": ["status", "rationale"],
      "properties": {
        "status": {"enum": ["PRESENT", "NOT_APPLICABLE", "UNRESOLVED"]},
        "rationale": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "project", "module", "api_id", "method", "path", "route_evidence",
    "controller_evidence", "validation_evidence", "service_evidence",
    "persistence_evidence", "transaction_evidence", "side_effect_evidence",
    "tables", "coverage", "candidates", "analysis_run_id", "status"
  ],
  "properties": {
    "project": {"enum": ["A", "B"]},
    "module": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"},
    "api_id": {"type": "string", "minLength": 1},
    "method": {"type": "string", "minLength": 1},
    "path": {"type": "string", "minLength": 1},
    "route_evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "controller_evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "validation_evidence": {"type": "array", "items": {"type": "object"}},
    "service_evidence": {"type": "array", "items": {"type": "object"}},
    "persistence_evidence": {"type": "array", "items": {"type": "object"}},
    "transaction_evidence": {"type": "array", "items": {"type": "object"}},
    "side_effect_evidence": {"type": "array", "items": {"type": "object"}},
    "tables": {"type": "array", "items": {"type": "string"}},
    "coverage": {
      "type": "object",
      "required": ["validation", "service", "persistence", "transaction", "side_effect", "tables"],
      "properties": {
        "validation": {"$ref": "#/$defs/coverage"},
        "service": {"$ref": "#/$defs/coverage"},
        "persistence": {"$ref": "#/$defs/coverage"},
        "transaction": {"$ref": "#/$defs/coverage"},
        "side_effect": {"$ref": "#/$defs/coverage"},
        "tables": {"$ref": "#/$defs/coverage"}
      },
      "additionalProperties": false
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "symbol", "reason", "confidence"],
        "properties": {
          "role": {"enum": ["validation", "service", "persistence"]},
          "symbol": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "confidence": {"const": "MEDIUM"}
        }
      }
    },
    "analysis_run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["PARTIAL", "ANALYZED", "REVIEW_REQUIRED"]}
  }
}
