{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "project", "business_id", "type", "module", "name", "classification",
    "confidence", "evidence", "related_apis", "related_tables", "analysis_run_id", "status"
  ],
  "properties": {
    "project": {"enum": ["A", "B"]},
    "business_id": {"type": "string", "minLength": 1},
    "type": {"type": "string", "minLength": 1},
    "module": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"},
    "name": {"type": "string", "minLength": 1},
    "classification": {"enum": ["FACT", "INFERENCE", "UNRESOLVED", "CONFLICT", "RISK", "DEAD_CODE_CANDIDATE"]},
    "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "related_apis": {"type": "array", "items": {"type": "string"}},
    "related_tables": {"type": "array", "items": {"type": "string"}},
    "related_modules": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "entity": {"type": "string", "minLength": 1},
    "from_state": {"type": "string", "minLength": 1},
    "to_state": {"type": "string", "minLength": 1},
    "trigger": {"type": "string", "minLength": 1},
    "scenario": {"type": "string", "minLength": 1},
    "mechanism": {"type": "string", "minLength": 1},
    "dependency_type": {"enum": ["call", "table", "event", "cache", "config", "external"]},
    "direction": {"enum": ["upstream", "downstream", "bidirectional", "unknown"]},
    "analysis_run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["PARTIAL", "ANALYZED", "REVIEW_REQUIRED"]}
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "state_transition"}}, "required": ["type"]}, "then": {"required": ["entity", "from_state", "to_state", "trigger"]}},
    {"if": {"properties": {"type": {"enum": ["idempotency_rule", "concurrency_rule"]}}, "required": ["type"]}, "then": {"required": ["scenario", "mechanism"]}},
    {"if": {"properties": {"type": {"const": "cross_module_dependency"}}, "required": ["type"]}, "then": {"required": ["related_modules", "dependency_type", "direction"]}}
  ]
}
