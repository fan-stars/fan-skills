# =============================================================================
# 本地密钥示例 — 复制为 site-rewrite/secrets.local.env 后填写
# 警告：secrets.local.env 已 gitignore，严禁提交、严禁写入 refactor.config.yaml
# =============================================================================

# ---------- 要重构的网站 ----------
LEGACY_USER=
LEGACY_PASSWORD=
LEGACY_COOKIE=
# 自定义请求头：LEGACY_HEADER_<头名称>=值
# 例：LEGACY_HEADER_X_API_TOKEN=

# ---------- 参考站（按 refactor.config.yaml 中的 site id）----------
# REF_<SITE_ID>_COOKIE=
# REF_<SITE_ID>_USER=
# REF_<SITE_ID>_PASSWORD=

# ---------- 数据接口凭证（按 dataApis[].secretsPrefix；下面以 PRIMARY 为例）----------
# DATA_API_PRIMARY_BASE_URL=     # 可选：覆盖配置里的 baseUrl
# DATA_API_PRIMARY_COOKIE=
# DATA_API_PRIMARY_PHPSESSID=
# DATA_API_PRIMARY_X_API_TOKEN=
# DATA_API_PRIMARY_X_USER_TOKEN=
# DATA_API_PRIMARY_HEADER_<头名称>=
