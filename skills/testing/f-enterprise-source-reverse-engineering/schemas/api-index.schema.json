{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "project", "module", "api_id", "method", "path", "route_evidence",
    "controller_evidence", "validation_evidence", "service_evidence",
    "persistence_evidence", "transaction_evidence", "side_effect_evidence",
    "tables", "analysis_run_id", "status"
  ],
  "properties": {
    "project": {"enum": ["A", "B"]},
    "module": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"},
    "api_id": {"type": "string", "minLength": 1},
    "method": {"type": "string", "minLength": 1},
    "path": {"type": "string", "minLength": 1},
    "route_evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "controller_evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "validation_evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "service_evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "persistence_evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "transaction_evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "side_effect_evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "tables": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "analysis_run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["PARTIAL", "ANALYZED", "REVIEW_REQUIRED"]}
  }
}
