{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["project", "file", "file_sha256", "symbol", "start_line", "end_line", "evidence_type", "semantic_basis", "confidence", "analysis_run_id", "status"],
  "properties": {
    "project": {"enum": ["A", "B"]},
    "file": {"type": "string", "minLength": 1},
    "file_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "symbol": {"type": "string", "minLength": 1},
    "start_line": {"type": "integer", "minimum": 1},
    "end_line": {"type": "integer", "minimum": 1},
    "evidence_type": {"type": "string", "minLength": 1},
    "semantic_basis": {"type": "string", "minLength": 1},
    "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
    "analysis_run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["CURRENT", "STALE"]},
    "reviewer": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"evidence_type": {"pattern": "_absence$"}}, "required": ["evidence_type"]},
      "then": {"required": ["reviewer", "reviewed_at"], "properties": {"semantic_basis": {"const": "reviewed_negative_evidence"}}}
    }
  ]
}
