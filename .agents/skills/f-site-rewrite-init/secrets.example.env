# =============================================================================
# 本地密钥示例 — 复制为 site-rewrite/secrets.local.env 后填写
# 警告：严禁提交该文件；严禁把真实密钥写入 refactor.config.yaml
# =============================================================================

# ---------- 要重构的网站 ----------
LEGACY_USER=
LEGACY_PASSWORD=
LEGACY_COOKIE=
# 自定义请求头：LEGACY_HEADER_<头名称>=值

# ---------- 参考站（按配置中的 site id）----------
# REF_<SITE_ID>_COOKIE=
# REF_<SITE_ID>_USER=
# REF_<SITE_ID>_PASSWORD=

# ---------- 数据接口（按 dataApis[].secretsPrefix）----------
# DATA_API_PRIMARY_COOKIE=
# DATA_API_PRIMARY_PHPSESSID=
# DATA_API_PRIMARY_X_API_TOKEN=
# DATA_API_PRIMARY_X_USER_TOKEN=
# DATA_API_PRIMARY_HEADER_<头名称>=

# ---------- 重构后本站 ----------
# REWRITE_COOKIE=
# REWRITE_HEADER_<头名称>=
